# ============================================================
#  HAVEX — настройки приёма заявок в Telegram
#  Скопируйте этот файл в .env и подставьте свои значения:
#      cp .env.example .env
# ============================================================

# 1) Создайте бота: напишите @BotFather в Telegram → /newbot
#    BotFather выдаст токен вида 1234567890:AAH...  — вставьте его сюда:
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# 2) Узнайте chat_id чата, куда падать заявки:
#    • Вариант А: напишите своему боту любое сообщение, затем откройте
#      https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
#      и найдите "chat":{"id":123456789}
#    • Вариант Б: добавьте бота в группу и используйте id группы (начинается с -100)
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# Порт сервера (необязательно)
PORT=3000

# ============================================================
#  Админ-панель /adminpanel/
# ============================================================

# Пароль для входа в панель. Если не задан — вход заблокирован.
# Придумайте свой, минимум 12 символов.
ADMIN_PASSWORD=

# Секрет для подписи cookie сессии. Сгенерируйте: openssl rand -hex 32
# Если не задан — сессии будут сбрасываться при каждом рестарте сервера.
ADMIN_SESSION_SECRET=

# Сколько часов живёт сессия после входа (по умолчанию 12)
ADMIN_SESSION_HOURS=12
